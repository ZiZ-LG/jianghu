[Unit]
Description=Recover an unfinished Stephen static-site activation
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=40

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/stephen-release-helper recover
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
