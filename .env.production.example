# 江湖 生产环境变量（docker compose 读取）
# 用法：cp .env.production.example .env  然后填好下面的值（.env 已被 gitignore，不会提交）
#
# 生成强随机密钥（各执行一次，把输出粘到下面）：
#   openssl rand -hex 32

# ── 数据库 ──
POSTGRES_USER=jianghu
POSTGRES_PASSWORD=__改成强密码__
POSTGRES_DB=jianghu

# ── 认证加密备份（主密钥另生成，不与数据库密码复用）──
# 生产默认放仓库外；目录权限建议 0700，并同步到受控异机介质。
BACKUP_DIR=/var/backups/jianghu
BACKUP_RETENTION_DAYS=14
# 必须是 `openssl rand -hex 32` 的完整 64-hex；占位/短值/复用数据库密码会拒绝运行。
BACKUP_MASTER_SECRET=__必须替换为独立64位十六进制主密钥__

# ── 后端密钥（务必改成 openssl rand -hex 32 的随机值）──
JWT_SECRET=__改成64位随机十六进制__
AI_KEY_SECRET=__改成另一段64位随机十六进制__

# CORE-115 通用 Customer 命令总开关；紧急回滚设为 0。
CUSTOMER_COMMANDS_ENABLED=1

# CORE-107 通用 Commitment 命令总开关；紧急回滚设为 0，旧 PlanAction adapter 继续可用。
COMMITMENT_COMMANDS_ENABLED=1

# CORE-110 方法论命令总开关；默认关闭。完成 migration/备份恢复验收后才显式设为 1。
METHODOLOGY_COMMANDS_ENABLED=0

# 产品 shell 与 capability 单一装配点。commercial 默认只开启 crm.core；
# 复杂能力使用逗号分隔的 entitlement key 显式开启。内部兼容部署设为 internal。
# 紧急回滚商业 shell：PRODUCT_EDITION=internal（不改写业务数据）。
PRODUCT_EDITION=commercial
PRODUCT_ENTITLEMENTS=

# ── 服务端出站主机白名单（仅主机名，逗号分隔）──
# AI / 得到大脑的自定义地址也必须由部署者加入，用户请求不能扩展白名单。
OUTBOUND_ALLOWED_HOSTS=open.feishu.cn,agent.qcc.com,openapi.biji.com,qyapi.weixin.qq.com
# 仅可信内网 HTTPS 服务需要填写；这里的主机会自动加入上面的主机白名单。
OUTBOUND_ALLOWED_PRIVATE_HOSTS=

# ── 跨域（同源部署留空即可；仅当前端与后端不同域名时才填，逗号分隔）──
CORS_ORIGIN=

# ── 前端 API 地址（同源部署留空 → 走相对 /api）──
VITE_API_URL=

# ── 备案审核期开关 ──
# 提交个人 ICP 备案、等管局审批期间，设为 1：网站对外只显示一个中性的「建设中」介绍页，
# 无登录/注册入口、不调用后端，降低个人备案被打回的概率。
# 备案号下来后改回 0（或留空）并重新 build，即恢复完整应用。
VITE_BEIAN_MODE=1

# ── 备案号（拿到后填入，网站页脚自动展示并链接到工信部备案系统；合规要求）──
# 形如：粤ICP备2026XXXXXX号
VITE_ICP_BEIAN=
# 公安联网备案（可选，部分地区要求）：
VITE_POLICE_BEIAN=
VITE_POLICE_BEIAN_URL=

# ── 对外端口（默认 80；若用宿主机 Caddy/Nginx 做 TLS，可改成 8080 仅本机）──
WEB_PORT=80

# ── 捐赠入口（个人可用，无需商户号；留空则前端只显示文案）──
DONATE_URL=https://ifdian.net/a/zizaiLG
DONATE_QR_URL=
DONATE_NOTE=江湖是免费的。如果它帮到了你的销售作战，欢迎在爱发电请作者喝杯咖啡 ☕
