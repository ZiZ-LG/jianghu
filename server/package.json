    "migrate:sales-hypothesis-apply": "tsx scripts/migrate-sales-hypotheses.ts --apply",
    "migrate:sales-hypothesis-verify": "tsx scripts/migrate-sales-hypotheses.ts --verify",
    "migrate:hypothesis-commitment-review-report": "tsx scripts/migrate-hypothesis-commitment-review.ts --dry-run",
