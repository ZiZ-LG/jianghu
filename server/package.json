    "migrate:wecom-bind-report": "tsx scripts/report-wecom-bind-conflicts.ts",
    "migrate:sync-anchor-report": "tsx scripts/report-sync-anchor-conflicts.ts",
    "schema:postgres:render": "node scripts/render-postgres-schema.mjs",
    "schema:postgres:check": "node scripts/render-postgres-schema.mjs --check",
    "release:metrics": "tsx scripts/report-internal-release-metrics.ts",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@jianghu/domain-contracts": "file:../packages/domain-contracts",
    "@jianghu/g64111": "file:../packages/g64111",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.10.0",
    "mammoth": "^1.12.0",
    "pde-kernel": "file:../packages/pde-kernel",
    "undici": "^7.28.0",
    "unpdf": "^1.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
