{
  "name": "jianghu-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "江湖 后端 · 多租户 SaaS API（Fastify + Prisma + JWT）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:db:prepare": "tsx scripts/prepareTestDb.ts",
    "test:db:push": "npm run test:db:prepare && DATABASE_URL=file:./test.db prisma db push --skip-generate",
    "pretest": "npm run test:db:push",
    "test": "DATABASE_URL=file:./test.db vitest run",
    "db:push": "tsx scripts/upgrade-sqlite-schema.ts",
    "db:studio": "prisma studio",
    "migrate:account-owners": "tsx scripts/backfill-account-owners.ts",
    "migrate:matter-report": "tsx scripts/migrate-matter-fields.ts --dry-run",
    "migrate:matter-apply": "tsx scripts/migrate-matter-fields.ts --apply",
    "migrate:matter-verify": "tsx scripts/migrate-matter-fields.ts --verify",
    "migrate:matter-participant-report": "tsx scripts/migrate-matter-participants.ts --dry-run",
    "migrate:matter-participant-apply": "tsx scripts/migrate-matter-participants.ts --apply",
