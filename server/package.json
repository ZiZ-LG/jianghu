{
  "name": "jianghu-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "江湖 后端 · 多租户 SaaS API（Fastify + Prisma + JWT）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:db:prepare": "tsx scripts/prepareTestDb.ts",
    "test:db:push": "npm run test:db:prepare && DATABASE_URL=file:./test.db prisma db push --skip-generate",
    "pretest": "npm run test:db:push",
    "test": "DATABASE_URL=file:./test.db vitest run",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@jianghu/domain-contracts": "file:../packages/domain-contracts",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
    "mammoth": "^1.12.0",
    "pde-kernel": "file:../packages/pde-kernel",
    "unpdf": "^1.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
