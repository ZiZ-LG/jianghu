# 复制为 .env 后填写（.env 不会被提交）
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
AI_KEY_SECRET="change-me-to-a-long-random-string"
PORT=3001

# CORE-107 通用 Commitment 命令总开关；紧急回滚可设为 0，旧 PlanAction adapter 继续可用。
COMMITMENT_COMMANDS_ENABLED=1

# CORE-110 方法论命令总开关；expand-only 阶段默认关闭，仅在完成部署校验后显式设为 1。
METHODOLOGY_COMMANDS_ENABLED=0

# commercial 默认为轻量 Free（crm.core）；内部兼容部署显式设为 internal。
# 可选增量：sales.workspace,team.operations,methodology.g64111,decision.pde
PRODUCT_EDITION=commercial
PRODUCT_ENTITLEMENTS=

# 服务端固定外部提供商白名单。自定义 AI/Getnote/QCC 主机须由部署者显式追加，不能由请求扩展。
OUTBOUND_ALLOWED_HOSTS=open.feishu.cn,agent.qcc.com,openapi.biji.com,qyapi.weixin.qq.com
# 本地/私网 HTTPS 提供商默认不允许；确需使用时由部署者显式填写主机名。
OUTBOUND_ALLOWED_PRIVATE_HOSTS=

# 公网基址（P2-b 录音接入·飞书妙记 OAuth 回调用；飞书服务器需能回调到此地址）。
# 生产填实际公网域名，如 https://nova-jianghu.glodon.com；本地开发可不设（代码有默认占位，本地不验 OAuth）。
# 飞书 App ID/Secret 不走 env——由各工作区管理员在「录音接入」入口填，AES 加密存 DB。
PUBLIC_BASE_URL="https://nova-jianghu.glodon.com"

# 生产：把 server/prisma/schema.prisma 的 provider 改为 postgresql，并换成你的连接串
# DATABASE_URL="postgresql://user:pass@host:5432/jianghu?schema=public"

# 捐赠入口（个人可用，无需商户号；留空则前端只显示文案）
# DONATE_URL="https://ifdian.net/a/yourname"
# DONATE_QR_URL="https://your-host/qr.png"
# DONATE_NOTE="江湖是免费的。如果它帮到了你的销售作战，欢迎请作者喝杯咖啡 ☕"
