// 江湖 多租户数据模型
// 开发：SQLite。生产：把 provider 改为 "postgresql" 并设置 DATABASE_URL 即可（字段未用原生 enum/json，跨库可移植）。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String    @id
  name               String
  plan               String    @default("free") // free | pro
  subscriptionStatus String    @default("active") // active | past_due | canceled
  seatLimit          Int       @default(50) // 免费多人协作，宽松上限防滥用（无付费墙）
  createdAt          DateTime  @default(now())
  users              User[]
  accounts           Account[]
  aiConfig           AiConfig?
  qccConfig          QccConfig?
}

// 工作区自配的企查查 OpenAPI 凭证（BYO-key）。secretKey 加密存储。
model QccConfig {
  tenantId     String   @id
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseUrl      String   @default("https://api.qichacha.com")
  appKey       String   @default("")
  secretKeyEnc String   @default("")
  updatedAt    DateTime @updatedAt
}

// 工作区自配的 AI 模型（BYO-key）：OpenAI 兼容。key 加密存储，用用户自己的额度调用。
model AiConfig {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  String   @default("openai-compatible") // openai-compatible | mock
  baseUrl   String   @default("")
  model     String   @default("")
  apiKeyEnc String   @default("") // AES-256-GCM 密文（base64）
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone        String?
  email        String?
  passwordHash String
  name         String
  role         String   @default("member") // owner | admin | member | viewer
  createdAt    DateTime @default(now())

  // 手机号/邮箱在「同一租户内」唯一（而非全局）——彻底消除跨租户撞号与 DoS，对齐「绝不跨租户」铁律。
  // 同一手机号可在不同工作区各建独立账号；登录时按 phone/email 定位候选、多工作区则让用户选。
  // NULL 在 SQLite/Postgres 均按 distinct 处理，故 phone/email 二选一时同租户内多行不冲突。
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId])
}

// AI 助手接入令牌（长效、可命名、可单独吊销，独立于登录态）。
// 库里只存哈希(sha256)，明文 jh_xxx 仅在生成时返回一次；用于外部 agent 调 /api/mcp。
model AccessToken {
  id         String    @id
  tenantId   String
  userId     String    // 归属用户（创建者）
  name       String    @default("") // 用户起的备注名（如"我的Workbuddy"）
  tokenHash  String    @unique // sha256(明文)，不可逆
  lastFour   String    @default("") // 明文后4位，仅供列表展示辨认
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // 最近一次用于鉴权的时间
  revokedAt  DateTime? // 非空=已吊销

  @@index([tenantId])
  @@index([userId])
}

model Account {
  id                String        @id
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  customerType      Int
  unifiedCreditCode String?
  externalRef       String?       // 销售包 customer_id，跨系统幂等主锚（WorkBuddy 集成）
  region            String        @default("")   // 大区
  group             String        @default("")   // 集团/母公司
  primaryOwner      String        @default("")   // 主负责人
  profile           String        @default("{}") // JSON：工商基础/集团关系/招投标/风险信号/我方现有合作/销售背景/AI建议
  createdAt         DateTime      @default(now())
  persons           Person[]
  opportunities     Opportunity[]
  edges             Edge[]

  @@index([tenantId])
}

model Person {
  id           String  @id
  tenantId     String
  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  title        String
  orgLevel     Int     @default(3)
  isCompetitor Boolean @default(false)
  avatarUrl    String?
  coachLevel   Int?
  color        String? // 节点高亮色（手动样式）
  x            Float   @default(300)
  y            Float   @default(240)
  form         String  @default("{}") // JSON
  logs         String  @default("[]") // JSON
  version      Int     @default(0) // 乐观锁：内容编辑并发冲突检测（UPDATE_PERSON）

  @@index([accountId])
}

model Opportunity {
  id                   String         @id
  tenantId             String
  accountId            String
  account              Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                 String
  customerType         Int
  pipelineStage        String
  engageStage          String
  changeMode           String?
  singleSalesGoal      String         @default("")
  customerBusinessGoal String?
  buyingMotivation     String?
  externalRef          String?                            // 销售包商机锚，跨系统幂等(WorkBuddy)
  status               String         @default("active")  // active/paused/won/lost
  productSolution      String         @default("")
  competitor           String         @default("")
  competitiveSituation String         @default("")        // 领先/胶着/落后/未识别
  winProbability       Float          @default(0)         // ⚠️ 销售在江湖自填，WorkBuddy 永不推/覆盖
  expectedSignDate     String         @default("")        // YYYY-MM-DD
  expectedAmountW      Float          @default(0)         // 万元
  meta                 String         @default("{}")      // JSON 兜底：BANT 辅助分等
  c3Items              String         @default("{}") // JSON
  c5Items              String         @default("{}") // JSON
  memberScoped         Boolean        @default(false) // false=全员可见(存量兼容)；true=按 OpportunityMember 过滤
  version              Int            @default(0) // 乐观锁：内容编辑并发冲突检测（UPDATE_OPP）
  roles                OppRole[]
  edges                Edge[]
  bis                  BurningIssue[]
  ucvs                 UCV[]
  suggestions          RelSuggestion[]
  members              OpportunityMember[]

  @@index([accountId])
}

// AI 关系推断候选（待人审）。绝不自动写库，accept 后才生成正式 Edge。
model RelSuggestion {
  id              String      @id
  tenantId        String
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourcePersonId  String      // 存 Person.id 或 PersonSuggestion.id（由 sourceKind 区分）
  targetPersonId  String      // 同上
  // 端点类型：person=正式干系人 / suggestion=尚未采纳的候选人物。默认 person（存量数据零迁移）。
  sourceKind      String      @default("person") // person | suggestion
  targetKind      String      @default("person") // person | suggestion
  layer           String
  label           String
  confidence      Float       @default(0.5)
  origin          String      @default("graph") // graph | llm | qcc | mcp
  evidence        String      @default("")
  status          String      @default("pending") // pending | accepted | rejected
  createdAt       DateTime    @default(now())

  @@index([opportunityId])
}

// AI/外部 agent 提议的「候选干系人」（待人审）。绝不自动写库，accept 后才生成正式 Person。
// 独立表存放：候选数据天然不在任何 Person 查询路径上，不会泄漏进侦探墙/趋赢力/只读 MCP（PIPL 红线）。
// 不存 form/family7/籍贯等敏感项；evidence 仅自由文本摘要，采纳后由用户补 FORM。
model PersonSuggestion {
  id               String   @id
  tenantId         String
  accountId        String   // 候选人物归属的客户（采纳时据此建正式 Person）
  opportunityId    String?  // 可选：提议时关联的商机
  name             String
  title            String   @default("")
  orgLevel         Int      @default(3)
  origin           String   @default("mcp") // mcp | ai | qcc
  evidence         String   @default("") // 自由文本（来源/依据摘要）
  sourceUrl        String?  // 调研来源链接（外部 agent 联网调研时带上）
  confidence       Float    @default(0.5)
  status           String   @default("pending") // pending | accepted | rejected
  proposedBy       String   @default("") // 提议者 userId（审计）
  resolvedPersonId String?  // 采纳后指向真实 Person.id（保证级联采纳幂等、去重）
  suggestedRole      String? // WorkBuddy 提议的 ADUR 角色 A/D/U/TB/R（采纳时落 OppRole，需配合 opportunityId）
  suggestedSentiment String? // 提议的支持度 star/plus/neutral/unknown/minus/x
  createdAt        DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

model OppRole {
  id                String      @id @default(uuid())
  tenantId          String
  opportunityId     String
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId          String
  role              String
  sentiment         String
  sentimentValue    Int?
  confidence        String
  isKeyInfluencer   Boolean     @default(false)
  procurementType   String?
  procurementStatus String?

  @@unique([opportunityId, personId])
}

// 商机成员：哪些干系人在该商机可见（仅当 Opportunity.memberScoped=true 生效）。关联表，跨库可移植。
model OpportunityMember {
  id            String      @id @default(uuid())
  tenantId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId      String

  @@unique([opportunityId, personId])
  @@index([opportunityId])
}

model Edge {
  id            String       @id
  tenantId      String
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  source        String
  target        String
  layer         String
  label         String
  color         String?
  style         String?
  width         Float?
  directed      Boolean      @default(false)
  origin        String       @default("manual")
  shape         String?      // 直线 straight / 折线 orthogonal / 曲线 curved（缺省按 layer 推断）
  bend          Float?       // 曲线弯曲度：控制点相对中点的垂直偏移(px，带符号)
  version       Int          @default(0) // 乐观锁：连线编辑并发冲突检测（UPDATE_EDGE）

  @@index([accountId])
}

model BurningIssue {
  id            String      @id
  tenantId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId      String
  description   String
  category      String
  isPrivate     Boolean     @default(true)
  confidence    String
}

model UCV {
  id               String      @id
  tenantId         String
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  targetBiId       String
  description      String
  competitorCannot String
  status           String
}

// 拜访记录（销售包核心产出，做一等模型）。与 Account 不建 Prisma relation——
// 候选/查询路径解耦，state.ts 单独按 accountId 挂载；participants 走 String 存 JSON（跨库可移植）。
model VisitNote {
  id            String   @id // visit_xxx
  tenantId      String
  accountId     String
  opportunityId String?
  externalRef   String?  // 销售包拜访记录锚，幂等
  date          String   @default("") // YYYY-MM-DD
  topic         String   @default("")
  summary       String   @default("") // WorkBuddy 提炼正文
  participants  String   @default("[]") // JSON: [{name, side: our|customer}]
  origin        String   @default("workbuddy")
  createdBy     String   @default("") // 提交者 userId
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 通用「自由文本层」载体（P0 · 架构纲领 §4.2）：零散/长尾信息的家。
// 三挂载对象皆可空——可挂客户/商机/人，也可先不挂(未归类)；挂 person/opp 时冗余存 accountId 便于按客户聚合。
model Note {
  id            String   @id // note_xxx
  tenantId      String
  accountId     String?  // 主挂载(冗余)：挂客户/商机/人时填该客户；未归类则空
  opportunityId String?
  personId      String?
  content       String   @default("") // 自由文本(原始零散信息·保真层)
  source        String   @default("manual") // 来源溯源：manual/voice/ai/import
  tags          String   @default("[]") // JSON 字符串数组(跨库可移植，不用原生 array)
  createdBy     String   @default("")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
  @@index([personId])
}

// 商机策划 · 行动计划（🎯）。与 Account 不建 relation，state.ts 按 accountId 挂载（同 VisitNote）。
// 字段全 String/Float/DateTime/Boolean，无 enum/json（跨库可移植）。
model PlanAction {
  id            String   @id // act_xxx
  tenantId      String
  accountId     String   // 冗余存：客户级日历直接按 accountId 聚合，免 join
  opportunityId String   // 必属某商机
  gapItem       String   @default("") // 关联 G64111 低分项：C1..C6 | P1..P4 | 1K（空=非补分动作）
  personId      String?  // 目标干系人
  title         String
  scene         String   @default("")
  scripts       String   @default("") // 话术（741 行动宝典可预填）
  target        String   @default("") // 期望达成
  ownerId       String   @default("")
  startDate     String   @default("") // YYYY-MM-DD ← 日历主锚（起）
  endDate       String   @default("") // YYYY-MM-DD（止；单日则 == startDate）
  half          String   @default("am") // 时段：am 上午 | pm 下午 | eve 晚上
  done          Boolean  @default(false) // 是否完成（仅行动有完成态）
  doneAt        String?  // 完成日期 YYYY-MM-DD
  review        String   @default("") // 复盘（喂周复盘）
  origin        String   @default("manual") // manual | ai(741) | workbuddy
  createdBy     String   @default("")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 商机策划 · 商机里程碑（🚩）。轻量，可多个/自由增删。同样按 accountId 挂载。
model OppMilestone {
  id            String   @id // ms_xxx
  tenantId      String
  accountId     String
  opportunityId String
  title         String   // 开标 / 立项评审 / 预计签约…
  startDate     String   @default("") // YYYY-MM-DD
  endDate       String   @default("") // 多为单日：== startDate
  half          String   @default("am")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 商机策划 · 阶段段（年视图，模型 B）。商机阶段 = 时间轴上一串阶段段，允许同名重复/降级回退。
model OppStage {
  id            String   @id // st_xxx
  tenantId      String
  accountId     String   // 冗余存：照 PlanAction/OppMilestone 按 accountId 挂载
  opportunityId String
  stageKey      String   // 需求引导|方案认可|客户立项|招投标|合同谈判|合同双签（可重复=降级回退）
  startDate     String   @default("") // YYYY-MM-DD
  endDate       String   @default("")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// ───────── 策略沙盘（推演段：关系地图 → 沙盘 → 行动策划 的中间「桥」）─────────
// 三表全 opp 级（带 opportunityId），accountId 冗余列照 PlanAction 按 accountId 挂载。
// 字段全 String/Int/Boolean/DateTime，无 enum/json（跨库可移植）。

// 策略卡（打法卡）。挂靠 G64111 低分项。origin=ai 时 status=pending 为顺推候选，人审采纳后 active。
model StrategyCard {
  id            String   @id // sc_xxx
  tenantId      String
  accountId     String   // 冗余存：照 PlanAction 按 accountId 挂载
  opportunityId String   // 沙盘根（1 商机 1 沙盘）
  gapItem       String   @default("") // 挂靠 G64111 低分项 C1..C6|P1..P4|1K（空=非补分打法）
  title         String   @default("")
  basis         String   @default("") // 依据
  alternatives  String   @default("") // 备选打法
  personId      String?  // 目标干系人（仅引用已存在 Person，AI 不得造新人）
  status        String   @default("active") // active | pending(AI候选待采纳) | dismissed
  origin        String   @default("manual") // manual | ai
  orderIndex    Int      @default(0)
  dispatchedActionIds String @default("[]") // JSON：已派生的 PlanAction id（防重复派发）
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 风险/假设。kind 区分二者（语义正交，不塞并列文本字段）。
model StrategyRisk {
  id            String   @id // sr_xxx
  tenantId      String
  accountId     String
  opportunityId String
  kind          String   @default("risk") // risk 风险 | assumption 假设
  text          String   @default("") // 风险描述 / 假设前提
  severity      String   @default("mid") // low | mid | high
  mitigation    String   @default("") // 缓解措施（assumption 时可空）
  status        String   @default("open") // open | resolved | dismissed
  origin        String   @default("manual") // manual | ai
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 轻量弹药清单（沙盘内自由列举，不建全局资源库/配额调度）。
model StrategyResource {
  id            String   @id // sx_xxx
  tenantId      String
  accountId     String
  opportunityId String
  label         String   @default("")
  kind          String   @default("") // 自由文本 product/relation/case/commercial…（不枚举）
  note          String   @default("")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 策略引擎 · 证据事件（E2）。每条证据 → 三态伪计数增量，喂局势分布。
// E2 简化：录入即生效（录入者即审核者）；status/审核轨迹（pending_review）留 E2.5。
// 不级联删除（审计资产）；signalKey 取自前端信号库常量（租户表化 SignalCatalog 留后续）。
model EvidenceEvent {
  id            String   @id // ev_xxx
  tenantId      String
  accountId     String   // 冗余存：照 PlanAction 按 accountId 挂载
  opportunityId String
  personId      String
  signalKey     String   // intro_referral / spec_alignment ...
  direction     Int      @default(0)  // +1 利好 / -1 不利（中性信号录入时人工定向）
  tier          String   @default("mid") // weak | mid | strong
  rawContent    String   @default("")    // 原文/纪要片段，可追溯
  occurredAt    String   @default("")    // YYYY-MM-DD
  createdBy     String   @default("")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 统一变更提案（机器写初稿·人审 v2.0）：机器对【已有实体字段】的更新先进此表（非静默覆盖），
// 人在收件箱看 改前→改后 diff + 趋赢力影响预览后采纳/改后采纳/驳回。采纳走既有 applyAction 落库。
// 跨库可移植：值一律 String 字符串化，不用原生 enum/json。
model ChangeProposal {
  id            String   @id
  tenantId      String
  accountId     String              // 归属客户（收件箱分组 + 隔离）
  opportunityId String?             // oppRole/商机字段提案带上
  entityKind    String              // oppRole | bi | opportunity | person（v2.0 先 oppRole）
  entityId      String              // 目标定位：oppRole 用 personId（配合 opportunityId）
  field         String              // 字段名，如 sentiment / confidence
  oldValue      String   @default("") // 改前值（字符串化，diff 展示）
  newValue      String              // 改后值
  origin        String   @default("voice") // voice | mcp | ai | qcc | engine
  evidence      String   @default("")
  confidence    Float    @default(0.5)
  status        String   @default("pending") // pending | accepted | rejected
  proposedBy    String   @default("")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([tenantId, status])
}

// 江湖自算 · 轻量后台任务队列（DB-backed，单实例 setInterval worker 消费）。
// 任务类型：enrich_account（建客户后企查查/AI 发现干系人 → PersonSuggestion 候选）；
//          suggest_relations（建/选商机后图算法+LLM 推断关系 → RelSuggestion 候选）。
// 产物一律走候选人审（铁律②）。不用原生 enum/json，全 String 跨库可移植；result 存 JSON 摘要。
model EnrichJob {
  id            String   @id
  tenantId      String
  type          String   @default("enrich_account") // enrich_account | suggest_relations | pull_recording
  accountId     String                              // 目标客户（两类任务都带，便于隔离/分组）
  opportunityId String?                             // suggest_relations 的目标商机
  mode          String   @default("auto")           // auto | web（enrich 数据源）
  status        String   @default("pending")        // pending | processing | done | failed
  attempts      Int      @default(0)
  result        String   @default("")               // JSON 摘要：{source, created, deduped, note} 或 {added}
  error         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([accountId])
}

// ── 录音转写原始层（PIPL 红线 · P2 录音接入）─────────────────────────────
// 从录音源（得到大脑 MCP / 飞书妙记 · 钉钉听记 OpenAPI / mock）拉来的转写文字。
// 「三层信息」里的【原始 raw】层：保真、不可变、带溯源；抽取出的结构化字段一律走提案人审（铁律②）。
// PIPL 配套：contentEnc = AES-256-GCM 密文（绝不明文落库）；status 控制最小留存（抽取后可降解/删除）；
// 全程 tenantId 强隔离。跨库可移植：全 String/Int/DateTime，无 enum/json。
model Transcript {
  id            String    @id // tr_xxx
  tenantId      String
  accountId     String?   // 可空挂载（拜访录音通常挂客户/商机；未归类可空）
  opportunityId String?
  personId      String?
  source        String    @default("mock") // 录音源：getnote(得到大脑) | feishu | dingtalk | manual | mock
  externalRef   String?   // 外部录音/笔记 id（幂等去重，避免重复拉取；空=本地/mock 不去重）
  title         String    @default("")      // 录音/会议标题（非隐私，可明文，列表展示用）
  contentEnc    String    @default("")      // 转写全文密文（AES-256-GCM base64）—— PIPL 加密，绝不明文落库
  durationSec   Int       @default(0)       // 录音时长（秒，溯源）
  recordedAt    DateTime?                   // 录音发生时间（溯源：何时）
  status        String    @default("active") // active(待抽取) | extracted(已抽取) | redacted(原文已降解/删除)
  extractedAt   DateTime?                   // 抽取时间（用完即可降解原文）
  createdBy     String    @default("")      // 拉取/导入者 userId（溯源：谁）
  createdAt     DateTime  @default(now())

  @@unique([tenantId, source, externalRef]) // 同租户同源同外部id 幂等（externalRef 为 NULL 时 distinct，不约束多行）
  @@index([tenantId, status])
  @@index([accountId])
}

// ── 录音源凭据（P2-b · BYO + OAuth）─────────────────────────────────────
// 凭据分两层（铁律④：全 AES-256-GCM 加密，绝不明文落库/外发）：
//   · 租户级 RecordingProviderConfig：企业应用 App 凭据（飞书 App ID/Secret），管理员配一次。
//   · per-user RecordingCredential：每个销售自己的授权（飞书 OAuth user token / 得到大脑 token）。
// 钉钉听记无转写开放 API → 改「文件上传(md/txt)」入口，不走凭据。跨库可移植：无 enum/json。
model RecordingProviderConfig {
  tenantId     String
  provider     String   // feishu（企业应用 OAuth 源）
  appId        String   @default("") // 飞书 App ID（非密钥，可明文）
  appSecretEnc String   @default("") // App Secret 密文（AES-256-GCM，绝不明文）
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@id([tenantId, provider])
}

model RecordingCredential {
  id              String    @id // rc_xxx
  tenantId        String
  userId          String    // per-user：授权的销售本人
  source          String    // feishu（OAuth user token） | getnote（得到大脑·手填 token）
  accessTokenEnc  String    @default("") // access/user token 密文
  refreshTokenEnc String    @default("") // refresh token 密文（飞书续期用）
  expiresAt       DateTime?              // access token 过期时间（用于自动 refresh）
  meta            String    @default("") // JSON：源特定信息（如得到大脑 endpoint）
  status          String    @default("active") // active | expired | revoked
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, userId, source]) // 一个销售一个源一条凭据（幂等覆盖）
  @@index([tenantId, userId])
}
