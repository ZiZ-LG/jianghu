// 江湖 多租户数据模型
// 开发：SQLite。生产：把 provider 改为 "postgresql" 并设置 DATABASE_URL 即可（字段未用原生 enum/json，跨库可移植）。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String    @id
  name               String
  plan               String    @default("free") // free | pro
  subscriptionStatus String    @default("active") // active | past_due | canceled
  seatLimit          Int       @default(50) // 免费多人协作，宽松上限防滥用（无付费墙）
  createdAt          DateTime  @default(now())
  users              User[]
  accounts           Account[]
  aiConfig           AiConfig?
  qccConfig          QccConfig?
}

// 工作区自配的企查查 OpenAPI 凭证（BYO-key）。secretKey 加密存储。
model QccConfig {
  tenantId     String   @id
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseUrl      String   @default("https://api.qichacha.com")
  appKey       String   @default("")
  secretKeyEnc String   @default("")
  updatedAt    DateTime @updatedAt
}

// 工作区自配的 AI 模型（BYO-key）：OpenAI 兼容。key 加密存储，用用户自己的额度调用。
model AiConfig {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  String   @default("openai-compatible") // openai-compatible | mock
  baseUrl   String   @default("")
  model     String   @default("")
  apiKeyEnc String   @default("") // AES-256-GCM 密文（base64）
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  name         String
  role         String   @default("member") // owner | admin | member | viewer
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

// AI 助手接入令牌（长效、可命名、可单独吊销，独立于登录态）。
// 库里只存哈希(sha256)，明文 jh_xxx 仅在生成时返回一次；用于外部 agent 调 /api/mcp。
model AccessToken {
  id         String    @id
  tenantId   String
  userId     String    // 归属用户（创建者）
  name       String    @default("") // 用户起的备注名（如"我的Workbuddy"）
  tokenHash  String    @unique // sha256(明文)，不可逆
  lastFour   String    @default("") // 明文后4位，仅供列表展示辨认
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // 最近一次用于鉴权的时间
  revokedAt  DateTime? // 非空=已吊销

  @@index([tenantId])
  @@index([userId])
}

model Account {
  id                String        @id
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  customerType      Int
  unifiedCreditCode String?
  externalRef       String?       // 销售包 customer_id，跨系统幂等主锚（WorkBuddy 集成）
  region            String        @default("")   // 大区
  group             String        @default("")   // 集团/母公司
  primaryOwner      String        @default("")   // 主负责人
  profile           String        @default("{}") // JSON：工商基础/集团关系/招投标/风险信号/我方现有合作/销售背景/AI建议
  createdAt         DateTime      @default(now())
  persons           Person[]
  opportunities     Opportunity[]
  edges             Edge[]

  @@index([tenantId])
}

model Person {
  id           String  @id
  tenantId     String
  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  title        String
  orgLevel     Int     @default(3)
  isCompetitor Boolean @default(false)
  avatarUrl    String?
  coachLevel   Int?
  color        String? // 节点高亮色（手动样式）
  x            Float   @default(300)
  y            Float   @default(240)
  form         String  @default("{}") // JSON
  logs         String  @default("[]") // JSON

  @@index([accountId])
}

model Opportunity {
  id                   String         @id
  tenantId             String
  accountId            String
  account              Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                 String
  customerType         Int
  pipelineStage        String
  engageStage          String
  changeMode           String?
  singleSalesGoal      String         @default("")
  customerBusinessGoal String?
  buyingMotivation     String?
  externalRef          String?                            // 销售包商机锚，跨系统幂等(WorkBuddy)
  status               String         @default("active")  // active/paused/won/lost
  productSolution      String         @default("")
  competitor           String         @default("")
  competitiveSituation String         @default("")        // 领先/胶着/落后/未识别
  winProbability       Float          @default(0)         // ⚠️ 销售在江湖自填，WorkBuddy 永不推/覆盖
  expectedSignDate     String         @default("")        // YYYY-MM-DD
  expectedAmountW      Float          @default(0)         // 万元
  meta                 String         @default("{}")      // JSON 兜底：BANT 辅助分等
  c3Items              String         @default("{}") // JSON
  c5Items              String         @default("{}") // JSON
  memberScoped         Boolean        @default(false) // false=全员可见(存量兼容)；true=按 OpportunityMember 过滤
  roles                OppRole[]
  edges                Edge[]
  bis                  BurningIssue[]
  ucvs                 UCV[]
  suggestions          RelSuggestion[]
  members              OpportunityMember[]

  @@index([accountId])
}

// AI 关系推断候选（待人审）。绝不自动写库，accept 后才生成正式 Edge。
model RelSuggestion {
  id              String      @id
  tenantId        String
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourcePersonId  String      // 存 Person.id 或 PersonSuggestion.id（由 sourceKind 区分）
  targetPersonId  String      // 同上
  // 端点类型：person=正式干系人 / suggestion=尚未采纳的候选人物。默认 person（存量数据零迁移）。
  sourceKind      String      @default("person") // person | suggestion
  targetKind      String      @default("person") // person | suggestion
  layer           String
  label           String
  confidence      Float       @default(0.5)
  origin          String      @default("graph") // graph | llm | qcc | mcp
  evidence        String      @default("")
  status          String      @default("pending") // pending | accepted | rejected
  createdAt       DateTime    @default(now())

  @@index([opportunityId])
}

// AI/外部 agent 提议的「候选干系人」（待人审）。绝不自动写库，accept 后才生成正式 Person。
// 独立表存放：候选数据天然不在任何 Person 查询路径上，不会泄漏进侦探墙/趋赢力/只读 MCP（PIPL 红线）。
// 不存 form/family7/籍贯等敏感项；evidence 仅自由文本摘要，采纳后由用户补 FORM。
model PersonSuggestion {
  id               String   @id
  tenantId         String
  accountId        String   // 候选人物归属的客户（采纳时据此建正式 Person）
  opportunityId    String?  // 可选：提议时关联的商机
  name             String
  title            String   @default("")
  orgLevel         Int      @default(3)
  origin           String   @default("mcp") // mcp | ai | qcc
  evidence         String   @default("") // 自由文本（来源/依据摘要）
  sourceUrl        String?  // 调研来源链接（外部 agent 联网调研时带上）
  confidence       Float    @default(0.5)
  status           String   @default("pending") // pending | accepted | rejected
  proposedBy       String   @default("") // 提议者 userId（审计）
  resolvedPersonId String?  // 采纳后指向真实 Person.id（保证级联采纳幂等、去重）
  suggestedRole      String? // WorkBuddy 提议的 ADUR 角色 A/D/U/TB/R（采纳时落 OppRole，需配合 opportunityId）
  suggestedSentiment String? // 提议的支持度 star/plus/neutral/unknown/minus/x
  createdAt        DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

model OppRole {
  id                String      @id @default(uuid())
  tenantId          String
  opportunityId     String
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId          String
  role              String
  sentiment         String
  sentimentValue    Int?
  confidence        String
  isKeyInfluencer   Boolean     @default(false)
  procurementType   String?
  procurementStatus String?

  @@unique([opportunityId, personId])
}

// 商机成员：哪些干系人在该商机可见（仅当 Opportunity.memberScoped=true 生效）。关联表，跨库可移植。
model OpportunityMember {
  id            String      @id @default(uuid())
  tenantId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId      String

  @@unique([opportunityId, personId])
  @@index([opportunityId])
}

model Edge {
  id            String       @id
  tenantId      String
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  source        String
  target        String
  layer         String
  label         String
  color         String?
  style         String?
  width         Float?
  directed      Boolean      @default(false)
  origin        String       @default("manual")
  shape         String?      // 直线 straight / 折线 orthogonal / 曲线 curved（缺省按 layer 推断）
  bend          Float?       // 曲线弯曲度：控制点相对中点的垂直偏移(px，带符号)

  @@index([accountId])
}

model BurningIssue {
  id            String      @id
  tenantId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId      String
  description   String
  category      String
  isPrivate     Boolean     @default(true)
  confidence    String
}

model UCV {
  id               String      @id
  tenantId         String
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  targetBiId       String
  description      String
  competitorCannot String
  status           String
}

// 拜访记录（销售包核心产出，做一等模型）。与 Account 不建 Prisma relation——
// 候选/查询路径解耦，state.ts 单独按 accountId 挂载；participants 走 String 存 JSON（跨库可移植）。
model VisitNote {
  id            String   @id // visit_xxx
  tenantId      String
  accountId     String
  opportunityId String?
  externalRef   String?  // 销售包拜访记录锚，幂等
  date          String   @default("") // YYYY-MM-DD
  topic         String   @default("")
  summary       String   @default("") // WorkBuddy 提炼正文
  participants  String   @default("[]") // JSON: [{name, side: our|customer}]
  origin        String   @default("workbuddy")
  createdBy     String   @default("") // 提交者 userId
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 商机策划 · 行动计划（🎯）。与 Account 不建 relation，state.ts 按 accountId 挂载（同 VisitNote）。
// 字段全 String/Float/DateTime/Boolean，无 enum/json（跨库可移植）。
model PlanAction {
  id            String   @id // act_xxx
  tenantId      String
  accountId     String   // 冗余存：客户级日历直接按 accountId 聚合，免 join
  opportunityId String   // 必属某商机
  gapItem       String   @default("") // 关联 G64111 低分项：C1..C6 | P1..P4 | 1K（空=非补分动作）
  personId      String?  // 目标干系人
  title         String
  scene         String   @default("")
  scripts       String   @default("") // 话术（741 行动宝典可预填）
  target        String   @default("") // 期望达成
  ownerId       String   @default("")
  startDate     String   @default("") // YYYY-MM-DD ← 日历主锚（起）
  endDate       String   @default("") // YYYY-MM-DD（止；单日则 == startDate）
  half          String   @default("am") // 时段：am 上午 | pm 下午 | eve 晚上
  done          Boolean  @default(false) // 是否完成（仅行动有完成态）
  doneAt        String?  // 完成日期 YYYY-MM-DD
  review        String   @default("") // 复盘（喂周复盘）
  origin        String   @default("manual") // manual | ai(741) | workbuddy
  createdBy     String   @default("")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}

// 商机策划 · 商机里程碑（🚩）。轻量，可多个/自由增删。同样按 accountId 挂载。
model OppMilestone {
  id            String   @id // ms_xxx
  tenantId      String
  accountId     String
  opportunityId String
  title         String   // 开标 / 立项评审 / 预计签约…
  startDate     String   @default("") // YYYY-MM-DD
  endDate       String   @default("") // 多为单日：== startDate
  half          String   @default("am")
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([opportunityId])
}
